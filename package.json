{
  "name": "svelte-table-views-sidebar",
  "version": "0.1.1",
  "description": "Grouped sidebar component for table views with collapsible sections, search, and pinned favorites.",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0",
    "svelte-table-views-tanstack": "^0.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "publint": "^0.2.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "svelte-table-views-tanstack": "^0.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "keywords": [
    "svelte",
    "table",
    "views",
    "sidebar",
    "grouped"
  ],
  "license": "MIT"
}
